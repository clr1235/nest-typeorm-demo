{{! 继承布局 }}
{{#> layouts/main title="首页" }}
    <div class="row">
        <div class="col-md-8">
            <h1 class="mb-4">欢迎使用 NestJS + Bootstrap</h1>
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">响应式布局示例</h5>
                    <p class="card-text">这是一个使用 Bootstrap 5 构建的响应式页面。</p>
                    
                    <!-- Bootstrap 组件示例 -->
                    <div class="row mt-4">
                        <div class="col-md-4 mb-3">
                            <div class="card text-white bg-primary">
                                <div class="card-body">
                                    <h5 class="card-title">卡片 1</h5>
                                    <p class="card-text">Bootstrap 卡片组件示例。</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card text-white bg-success">
                                <div class="card-body">
                                    <h5 class="card-title">卡片 2</h5>
                                    <p class="card-text">Bootstrap 卡片组件示例。</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card text-white bg-warning">
                                <div class="card-body">
                                    <h5 class="card-title">卡片 3</h5>
                                    <p class="card-text">Bootstrap 卡片组件示例。</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 按钮示例 -->
                    <button type="button" class="btn btn-primary mt-3" data-bs-toggle="modal" data-bs-target="#exampleModal">
                        打开模态框
                    </button>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    侧边栏
                </div>
                <div class="card-body">
                    <h5 class="card-title">Bootstrap 功能</h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">响应式网格系统</li>
                        <li class="list-group-item">预定义组件</li>
                        <li class="list-group-item">实用工具类</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- 模态框 -->
    <div class="modal fade" id="exampleModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Bootstrap 模态框</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>这是一个 Bootstrap 模态框示例。</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">关闭</button>
                    <button type="button" class="btn btn-primary">保存</button>
                </div>
            </div>
        </div>
    </div>
{{/layouts/main}}